# ---------------------------------------------------------------------------
# Hint Backend - environment template
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hint

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth (JWT)
JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production
JWT_REFRESH_TTL=30d

# Nearby Mode / geofence rules
NEARBY_SESSION_TTL_MINUTES=30
NEARBY_RADIUS_METERS=250
LOCATION_MAX_AGE_SECONDS=120
LOCATION_MAX_ACCURACY_METERS=100

# Rate limiting (global default)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Queues (BullMQ)
QUEUE_PREFIX=hint
QUEUE_CONCURRENCY=5
